rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // The public website does not need to read user profiles.
    // User profiles are only available to the signed-in admin account.
    match /users/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Anyone with the website link can read live players and matches.
    // Player removal is a soft delete (active: false), so historical records remain intact.
    // Only the admin can create, update or delete them.
    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
