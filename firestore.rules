rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // A signed-in account must be able to read its own profile so the
    // admin-role check can resolve without a circular permission dependency.
    // Only an existing admin can create/update/delete user profiles.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if isAdmin();
    }

    // Anyone with the website link can read live players and matches.
    // Player removal is a soft delete (active: false), so historical records remain intact.
    // Only the admin can create, update or delete them.
    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Turf information is a standalone reference directory and never owns match/financial data.
    match /turfs/{turfId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
